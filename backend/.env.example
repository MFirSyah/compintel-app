# COMPINTEL Backend
COMPINTEL_BACKEND_URL=http://localhost:8000
API_PREFIX=/api

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/compintel
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compintel

# ML Configuration
TFIDF_ALPHA=0.5
TFIDF_THRESHOLD=0.60
SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./data/uploads

# Server
HOST=0.0.0.0
PORT=8000
